# Copy to .env and fill in. Never commit .env.

# --- Keys ---
NVIDIA_API_KEY=            # build.nvidia.com, starts nvapi-
WANDB_API_KEY=             # wandb.ai/authorize
HF_TOKEN=                  # huggingface.co/settings/tokens (read); only for pulling Cosmos weights
RUNPOD_API_KEY=            # only to start/stop the Cosmos pod from the laptop (runpodctl, REST)

# --- Vision model: the Cosmos seam. Change these lines on the day, nothing else. ---
# DEFAULT: Cosmos-Reason2-8B on our RunPod pod. The pod must be running (CLAUDE.md "Pod ops").
VLM_BASE_URL=https://exfdzxdrcdk7st-8000.proxy.runpod.net/v1
VLM_MODEL=nvidia/Cosmos-Reason2-8B
VLM_FRAME_FORMAT=images    # one image_url per frame; Cosmos accepts up to 16
VLM_API_KEY=               # optional; the pod accepts any string, NVIDIA hosted needs NVIDIA_API_KEY
# FALLBACK when the pod is off: comment out the three lines above. With them unset, config.py uses
# Llama 3.2 11B Vision on NVIDIA's hosted API with VLM_FRAME_FORMAT=montage (it takes one image per
# call, so frames are tiled into one numbered image). Fine for plumbing work, poor as a judge.
# (video_frames is a third format, Cosmos NIM only.)

# --- Agent LLM on W&B Inference ---
AGENT_BASE_URL=https://api.inference.wandb.ai/v1
AGENT_MODEL=meta-llama/Llama-3.3-70B-Instruct
AGENT_API_KEY=             # optional; defaults to WANDB_API_KEY

# --- W&B logging ---
WANDB_PROJECT=liveness-agent
WANDB_ENTITY=              # your W&B username or team; blank = default entity

# --- Perception ---
YOLO_MODEL=yolo11n.pt      # downloaded on first use

# --- Verdict log backend: sqlite (one file, data/index/sessions.db) | local (JSONL) | vast (on the day) ---
INDEX_BACKEND=sqlite
