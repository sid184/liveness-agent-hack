# Copy to .env and fill in. Never commit .env.

# --- Keys ---
NVIDIA_API_KEY=            # build.nvidia.com, starts nvapi-
HF_TOKEN=                  # huggingface.co/settings/tokens (read); only for pulling Cosmos weights
RUNPOD_API_KEY=            # only to start/stop the Cosmos pod from the laptop (runpodctl, REST)

# --- Vision model: the Cosmos seam. Change these lines, nothing else. ---
# DEFAULT on event day: NVIDIA Cosmos3-Reason on the organisers' GPU endpoint. Copy the team's
# /config/<team>.config to .env.team (gitignored) and the token is picked up from there.
VLM_BASE_URL=http://166.19.38.112:8001/v1
VLM_MODEL=nvidia/cosmos3-nano-reasoner  # the id the event endpoint serves (GET /v1/models)
VLM_API_KEY=${GPU_BEARER_TOKEN}
VLM_FRAME_FORMAT=images    # images: one image_url per sampled frame. video: send the mp4 itself.
VLM_MAX_IMAGES=5           # the event Cosmos3 endpoint accepts at most 5 images; blank = no cap
PROMPT_VERSION=v6          # judge prompt in reason/prompts.py COHERENCE_VERSIONS; make eval compares
# BACKUP: our own Cosmos-Reason2-8B pod on RunPod (CLAUDE.md "Pod ops"), any VLM_API_KEY string:
#   VLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1  VLM_MODEL=nvidia/Cosmos-Reason2-8B
# FALLBACK with no GPU: comment out all VLM_* lines. config.py then uses Llama 3.2 11B Vision on
# NVIDIA's hosted API with montage mode (one image per call). Fine for plumbing, poor as a judge.

# --- Organisers' stack: do NOT fill in here. scp /config/<team>.config to .env.team instead. ---
# GPU_BEARER_TOKEN, COSMOS3_REASON_URL, YOLO_URL, COSMOS_EMBED1_URL, INGRESS_URL, USERNAME,
# PASSWORD, S3_ENDPOINT, ACCESS_KEY, SECRET_KEY, VASTDB_BUCKET, VDB_SCHEMA, WANDB_API_KEY ...

# --- Agent LLM on W&B Inference: writes the call's decision note ---
AGENT_BASE_URL=https://api.inference.wandb.ai/v1
AGENT_MODEL=meta-llama/Llama-3.3-70B-Instruct
AGENT_API_KEY=             # optional; defaults to WANDB_API_KEY
AGENT_ENABLED=1            # 0: Cosmos's own text as the note

# --- W&B logging and Weave tracing ---
# Our own W&B project. .env overrides .env.team and the shell, so these win over the organisers'
# team key that the lab VM exports. Delete all three to log to the team project instead.
WANDB_API_KEY=             # wandb.ai/authorize (personal)
WANDB_ENTITY=karimbakkali15-test
WANDB_PROJECT=liveness-agent
WEAVE_ENABLED=1            # one Weave trace per session (YOLO -> Cosmos -> agent)

# --- Perception ---
YOLO_MODEL=yolo11n-pose.pt # pose keypoints: head, shoulders, wrists; downloaded on first use
YOLO_DETECT_MODEL=yolo11n.pt # COCO objects: a phone or screen around the face, a cup at it

# --- Verdict log backend: vast (our table in the team VastDB) | sqlite (data/index/sessions.db) ---
# vast needs .env.team; `make check` says whether it is reachable. Fall back to sqlite if not.
INDEX_BACKEND=vast
VAST_SCHEMA=hackathon      # our own schema in VASTDB_BUCKET; never vss-schema
VAST_TABLE=liveness_sessions

# --- VSS archive: each session clip uploaded to the team archive with verdict/label tags ---
VSS_ARCHIVE=1
VSS_CAMERA_ID=liveness

# --- Hosted UI (Vercel) origins allowed to call the local API, comma-separated ---
UI_ORIGINS=
