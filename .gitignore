# Secrets: real keys live in .env / .env.* and never get committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Model weights and runtime output
*.pt
*.onnx
runs/
wandb/
data/*
!data/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# UI build tooling (ui/static is the committed build output)
ui/web/node_modules/
ui/web/dist/
.vercel/
weave/
